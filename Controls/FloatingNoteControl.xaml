<UserControl x:Class="YogaNotes.Controls.FloatingNoteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300"
             MinWidth="150" MinHeight="60">

    <UserControl.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="OuterBorder" 
            Background="#FFFFFFFF" 
            BorderBrush="#CBD5E1" 
            BorderThickness="1" 
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Drag Handle & Controls Bar -->
            <Border x:Name="HeaderBar" Grid.Row="0" 
                    Background="#F8FAFC" 
                    CornerRadius="5,5,0,0" 
                    Height="24" 
                    Cursor="SizeAll" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                    MouseMove="HeaderBar_MouseMove"
                    MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp">
                <Grid Margin="6,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Drag grip dots -->
                        <TextBlock Text="⋮⋮" FontSize="12" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Note" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Delete button -->
                        <Button x:Name="DeleteButton" Content="✕" 
                                ToolTip="Delete Note Container" 
                                Style="{StaticResource HeaderButtonStyle}" 
                                FontSize="10" 
                                Width="18" Height="18" 
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editable Text Box -->
            <TextBox x:Name="NoteTextBoxControl" Grid.Row="1"
                     Margin="6,4,6,6"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14"
                     FontFamily="Segoe UI, Segoe UI Variable Text, Arial"
                     Foreground="#1E293B"
                     TextChanged="NoteTextBoxControl_TextChanged"
                     GotFocus="NoteTextBoxControl_GotFocus"
                     LostFocus="NoteTextBoxControl_LostFocus"/>

            <!-- Resize Thumb at bottom right -->
            <Thumb x:Name="ResizeThumb" Grid.Row="1"
                   Width="12" Height="12" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate>
                        <Path Data="M 12,0 L 12,12 L 0,12 Z" Fill="#94A3B8" Margin="0,0,1,1" Opacity="0.7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
