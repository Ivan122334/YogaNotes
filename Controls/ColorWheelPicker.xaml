<UserControl x:Class="YogaNotes.Controls.ColorWheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260"
             Background="White">

    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Color Picker" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="PreviewSwatch" Width="22" Height="22" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,6,0" Background="#0F172A"/>
                    <TextBlock x:Name="PreviewHexLabel" Text="#0F172A" FontSize="12" FontFamily="Consolas" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Interactive Color Wheel -->
            <Grid Width="180" Height="180" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Image x:Name="WheelImage" Width="180" Height="180" Stretch="None" Cursor="Cross"
                       MouseLeftButtonDown="WheelImage_MouseDown"
                       MouseMove="WheelImage_MouseMove"
                       MouseLeftButtonUp="WheelImage_MouseUp"/>
                <Canvas IsHitTestVisible="False" Width="180" Height="180">
                    <Ellipse x:Name="WheelSelector" Width="14" Height="14" Stroke="White" StrokeThickness="2.5" Canvas.Left="83" Canvas.Top="83">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Brightness / Value Slider -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Brightness" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0.05" Maximum="1.0" Value="1.0"
                        VerticalAlignment="Center" ValueChanged="BrightnessSlider_ValueChanged"/>
            </Grid>

            <!-- Hex & Name Search Input -->
            <TextBlock Text="Hex code or color name" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,8">
                <TextBox x:Name="SearchHexBox" Height="32" VerticalContentAlignment="Center" Padding="8,2"
                         FontSize="12" FontFamily="Consolas, Segoe UI"
                         BorderBrush="#CBD5E1" BorderThickness="1"
                         TextChanged="SearchHexBox_TextChanged"
                         KeyDown="SearchHexBox_KeyDown"/>
                <TextBlock x:Name="SearchPlaceholder" Text="#7719AA or 'coral', 'teal'..."
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Search Results Swatches -->
            <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="SearchResultsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
