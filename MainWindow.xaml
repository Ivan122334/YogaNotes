<Window x:Class="YogaNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YogaNotes"
        xmlns:controls="clr-namespace:YogaNotes.Controls"
        mc:Ignorable="d"
        Title="YogaNotes — OneNote for Lenovo Yoga" 
        Height="850" Width="1350"
        MinHeight="500" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Segoe UI Variable Display, Arial">

    <Window.Resources>
        <!-- OneNote Purple Brand Color -->
        <SolidColorBrush x:Key="OneNotePurple" Color="#7719AA"/>
        <SolidColorBrush x:Key="OneNotePurpleHover" Color="#60138B"/>
        <SolidColorBrush x:Key="OneNotePurpleLight" Color="#F3E8FF"/>

        <!-- Touch Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource OneNotePurpleLight}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OneNotePurple}"/>
                                <Setter Property="Foreground" Value="{StaticResource OneNotePurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Circle Button Style -->
        <Style x:Key="ColorChipStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2.5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="#CBD5E1" StrokeThickness="1.2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#0F172A"/>
                                <Setter TargetName="Circle" Property="StrokeThickness" Value="2.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Responsive Top Ribbon Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area (Sidebar + Canvas) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= RESPONSIVE TOP TOOLBAR ================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,5" SnapsToDevicePixels="True">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- App Logo & Navigation Toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnToggleSidebar" Style="{StaticResource FlatButtonStyle}" Width="36" Height="36" Padding="0" Click="BtnToggleSidebar_Click" ToolTip="Toggle Navigation Sidebar">
                        <TextBlock Text="☰" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OneNotePurple}"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="6,0,6,0" VerticalAlignment="Center">
                        <Border Background="{StaticResource OneNotePurple}" CornerRadius="4" Width="24" Height="24" Margin="0,0,6,0">
                            <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YogaNotes" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="4,0"/>
                </StackPanel>

                <!-- Mode Selector Group -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <RadioButton x:Name="ToolText" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" IsChecked="True" ToolTip="Type Anywhere (Click canvas to create a note box)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔤" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Type" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ToolPen" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" ToolTip="Ballpoint Pen (Pressure sensitive — no note bubbles)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Pen" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ToolWriteText" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" ToolTip="Writing Mode — Recognizes cursive English or Bulgarian handwriting as text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✍️" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Write→Text" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ToolShape" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" ToolTip="Shape Mode — Rough circles, rectangles, triangles, and lines snap cleanly like Paint">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔷" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Shape" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ToolHighlighter" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" ToolTip="Highlighter (Translucent bright colors only)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖍️" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Highlight" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ToolEraser" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" ToolTip="Eraser (or flip your Lenovo pen around)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Eraser" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ToolSelect" GroupName="ToolGroup" Style="{StaticResource ToolButtonStyle}" Click="ToolButton_Click" ToolTip="Lasso Select &amp; Move">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬚" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lasso" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Writing Mode Language Selector (Visible when Write->Text is active) -->
                <StackPanel x:Name="WriteModeControlsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0">
                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="4,0,8,0"/>
                    <ComboBox x:Name="ComboWriteLanguage" Width="118" Height="34" VerticalContentAlignment="Center" SelectionChanged="ComboWriteLanguage_SelectionChanged" ToolTip="Handwriting Recognition Language">
                        <ComboBoxItem Content="🇬🇧 English" Tag="English" IsSelected="True"/>
                        <ComboBoxItem Content="🇧🇬 Български" Tag="Bulgarian"/>
                    </ComboBox>
                    <Button x:Name="BtnConvertNow" Style="{StaticResource FlatButtonStyle}" Height="34" Margin="4,2,0,2" Padding="8,2" Click="BtnConvertNow_Click" ToolTip="Convert pending handwritten strokes to text right now">
                        <TextBlock Text="✓ Convert" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OneNotePurple}"/>
                    </Button>
                </StackPanel>

                <!-- Color Palette & Color Wheel Picker -->
                <StackPanel x:Name="ColorSectionPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="4,0,8,0"/>

                    <!-- Standard Pen Colors -->
                    <StackPanel x:Name="PenColorsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="#0F172A" Style="{StaticResource ColorChipStyle}" ToolTip="Black (#0F172A)" Click="ColorChip_Click"/>
                        <Button Background="#2563EB" Style="{StaticResource ColorChipStyle}" ToolTip="Navy Blue (#2563EB)" Click="ColorChip_Click"/>
                        <Button Background="#DC2626" Style="{StaticResource ColorChipStyle}" ToolTip="Crimson Red (#DC2626)" Click="ColorChip_Click"/>
                        <Button Background="#059669" Style="{StaticResource ColorChipStyle}" ToolTip="Emerald Green (#059669)" Click="ColorChip_Click"/>
                        <Button Background="#7C3AED" Style="{StaticResource ColorChipStyle}" ToolTip="OneNote Purple (#7C3AED)" Click="ColorChip_Click"/>
                        <Button Background="#EA580C" Style="{StaticResource ColorChipStyle}" ToolTip="Orange (#EA580C)" Click="ColorChip_Click"/>
                    </StackPanel>

                    <!-- Highlighter-Only Bright Colors (Removes dark/black colors when Highlighter is chosen) -->
                    <StackPanel x:Name="HighlighterColorsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button Background="#FACC15" Style="{StaticResource ColorChipStyle}" ToolTip="Yellow Highlighter (#FACC15)" Click="ColorChip_Click"/>
                        <Button Background="#86EFAC" Style="{StaticResource ColorChipStyle}" ToolTip="Mint Green Highlighter (#86EFAC)" Click="ColorChip_Click"/>
                        <Button Background="#67E8F9" Style="{StaticResource ColorChipStyle}" ToolTip="Cyan Highlighter (#67E8F9)" Click="ColorChip_Click"/>
                        <Button Background="#F472B6" Style="{StaticResource ColorChipStyle}" ToolTip="Pink Highlighter (#F472B6)" Click="ColorChip_Click"/>
                        <Button Background="#FDBA74" Style="{StaticResource ColorChipStyle}" ToolTip="Peach Orange Highlighter (#FDBA74)" Click="ColorChip_Click"/>
                        <Button Background="#D8B4FE" Style="{StaticResource ColorChipStyle}" ToolTip="Lavender Highlighter (#D8B4FE)" Click="ColorChip_Click"/>
                    </StackPanel>

                    <!-- Color Wheel + Hex Search Button -->
                    <Button x:Name="BtnColorWheel" Style="{StaticResource FlatButtonStyle}" Height="34" Margin="6,2,0,2" Padding="8,2" Click="BtnColorWheel_Click" ToolTip="Open Color Wheel &amp; Search by Hex or Name">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ActiveColorDot" Width="15" Height="15" Fill="#0F172A" Stroke="#64748B" StrokeThickness="1.2" Margin="0,0,5,0"/>
                            <TextBlock Text="🎨 Wheel / Hex" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Popup hosting ColorWheelPicker -->
                    <Popup x:Name="ColorWheelPopup" PlacementTarget="{Binding ElementName=BtnColorWheel}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <controls:ColorWheelPicker x:Name="ColorWheelControl" Margin="4"/>
                    </Popup>
                </StackPanel>

                <!-- Thickness & Paper Style Dropdowns -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="4,0,8,0"/>

                    <ComboBox x:Name="ComboStrokeThickness" Margin="2,2" Width="104" Height="34" VerticalContentAlignment="Center" SelectionChanged="ComboStrokeThickness_SelectionChanged" ToolTip="Stroke Size">
                        <ComboBoxItem Content="Fine (2pt)" Tag="2" IsSelected="True"/>
                        <ComboBoxItem Content="Medium (4pt)" Tag="4"/>
                        <ComboBoxItem Content="Thick (8pt)" Tag="8"/>
                        <ComboBoxItem Content="Marker (16pt)" Tag="16"/>
                    </ComboBox>

                    <ComboBox x:Name="ComboPaperStyle" Margin="4,2" Width="114" Height="34" VerticalContentAlignment="Center" SelectionChanged="ComboPaperStyle_SelectionChanged" ToolTip="Paper Background">
                        <ComboBoxItem Content="Ruled / Lined" Tag="Ruled" IsSelected="True"/>
                        <ComboBoxItem Content="Grid Paper" Tag="Grid"/>
                        <ComboBoxItem Content="Blank Sheet" Tag="Blank"/>
                    </ComboBox>
                </StackPanel>

                <!-- Utility Actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="4,0,6,0"/>

                    <Button x:Name="BtnUndo" Style="{StaticResource FlatButtonStyle}" ToolTip="Undo Ink (Ctrl+Z)" Click="BtnUndo_Click" Width="36" Height="34" Padding="0">
                        <TextBlock Text="↩" FontSize="15" FontWeight="Bold"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource FlatButtonStyle}" ToolTip="Redo Ink (Ctrl+Y)" Click="BtnRedo_Click" Width="36" Height="34" Padding="0">
                        <TextBlock Text="↪" FontSize="15" FontWeight="Bold"/>
                    </Button>
                    <Button x:Name="BtnClear" Style="{StaticResource FlatButtonStyle}" Height="34" ToolTip="Clear Page Ink" Click="BtnClear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,3,0" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExport" Style="{StaticResource FlatButtonStyle}" Height="34" ToolTip="Export Note as Image (PNG)" Click="BtnExport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,3,0" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Export" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ================= MAIN BODY (Sidebar & Canvas) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Notebooks / Sections / Pages -->
                <ColumnDefinition x:Name="SidebarColDef" Width="290" MinWidth="0" MaxWidth="420"/>
                <ColumnDefinition x:Name="SplitterColDef" Width="Auto"/>
                <!-- Canvas Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Notebook Picker -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="NOTEBOOK" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ComboNotebooks" Grid.Column="0" Height="34" VerticalContentAlignment="Center" SelectionChanged="ComboNotebooks_SelectionChanged" DisplayMemberPath="Name"/>

                                <Button x:Name="BtnNewNotebook" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource FlatButtonStyle}" Height="34" Width="34" Padding="0" ToolTip="Create New Notebook" Click="BtnNewNotebook_Click">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OneNotePurple}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. Section Selector -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="SECTIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Button x:Name="BtnNewSection" HorizontalAlignment="Right" Style="{StaticResource FlatButtonStyle}" Height="24" Padding="6,1" Click="BtnNewSection_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontWeight="Bold" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="Section" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListBox x:Name="ListSections" Grid.Row="1" MaxHeight="140" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" SelectionChanged="ListSections_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource OneNotePurpleLight}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 3. Pages List -->
                    <Grid Grid.Row="2" Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="PAGES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Button x:Name="BtnNewPage" HorizontalAlignment="Right" Background="{StaticResource OneNotePurple}" Foreground="White" BorderThickness="0" Height="28" Padding="10,2" Cursor="Hand" Click="BtnNewPage_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" FontWeight="Bold" FontSize="13" Margin="0,0,4,0" Foreground="White"/>
                                                <TextBlock Text="Add Page" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ListBox x:Name="ListPages" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ListPages_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource OneNotePurpleLight}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource OneNotePurple}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM dd, yyyy  h:mm tt}'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="✕" Width="18" Height="18" FontSize="9" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnDeletePage_Click" ToolTip="Delete Page" Tag="{Binding Id}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter to resize sidebar -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- ================= MAIN CANVAS ================= -->
            <Grid Grid.Column="2">
                <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                    <Grid x:Name="CanvasContainer" Width="2600" Height="3600" Background="#FFFFFF">
                        <!-- Background Paper Pattern (Ruled / Grid / Blank) -->
                        <Border x:Name="PaperBackgroundBorder" Background="#FFFFFF"/>

                        <!-- Responsive OneNote Page Title Header Area -->
                        <StackPanel x:Name="PageHeaderPanel" Margin="48,36,48,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="820">
                            <TextBox x:Name="TxtPageTitle" 
                                     Text="Untitled Page" 
                                     FontSize="28" 
                                     FontWeight="Bold" 
                                     Foreground="#0F172A" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Padding="0,0,0,4"
                                     TextChanged="TxtPageTitle_TextChanged"/>

                            <TextBlock x:Name="TxtPageTimestamp" 
                                       Text="Monday, November 23, 2026" 
                                       FontSize="12" 
                                       Foreground="#64748B" 
                                       Margin="2,0,0,12"/>

                            <Rectangle Height="1" Fill="#CBD5E1" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>
                        </StackPanel>

                        <!-- WPF InkCanvas: Freeform Drawing + Children Floating Notes -->
                        <InkCanvas x:Name="MainInkCanvas" 
                                   Background="Transparent" 
                                   Margin="0,120,0,0"
                                   PreviewMouseLeftButtonDown="MainInkCanvas_PreviewMouseLeftButtonDown"
                                   StrokeCollected="MainInkCanvas_StrokeCollected"
                                   StrokeErased="MainInkCanvas_StrokeErased"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <TextBlock x:Name="StatusModeText" Text="Type Mode — Click anywhere on the canvas to create a floating note" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusColorText" Text="Color: #0F172A" FontSize="11.5" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= MODAL DIALOG (Prompt for New Notebook/Section) ================= -->
        <Grid x:Name="ModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8" Width="400" MaxWidth="420" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ModalTitle" Text="Create New Notebook" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ModalPrompt" Text="Enter name:" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="ModalInput" Height="34" VerticalContentAlignment="Center" FontSize="14" Padding="6,2" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource FlatButtonStyle}" Width="80" Click="ModalCancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ModalConfirmButton" Content="Create" Background="{StaticResource OneNotePurple}" Foreground="White" Width="90" Height="38" FontWeight="SemiBold" Cursor="Hand" Click="ModalConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
